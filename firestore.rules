rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Fonction helper pour vérifier si l'utilisateur est connecté
    function isAuthenticated() {
      return request.auth != null;
    }

    // Fonction helper pour vérifier si l'utilisateur est un admin
    function isAdmin() {
      return isAuthenticated() && (
        // Super Admin (hardcodé pour éviter de se bloquer soi-même)
        request.auth.token.email == 'noellinemous@gmail.com' || 
        // Admin dynamique (vérifie si un document avec l'email existe dans la collection 'admins')
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email))
      );
    }

    // ============================================================================
    // RÈGLES POUR LA COLLECTION 'ADMINS' (GESTION DES ADMINISTRATEURS)
    // ============================================================================
    match /admins/{email} {
      allow read, write: if isAdmin();
    }

    // ============================================================================
    // RÈGLES POUR LA COLLECTION 'VEHICLES' (VÉHICULES)
    // ============================================================================
    match /vehicles/{vehicleId} {
      allow read: if true;
      allow create: if true; 
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['favoritesCount'])
      );
      allow delete: if isAdmin();
    }

    // ============================================================================
    // RÈGLES POUR LA COLLECTION 'CATEGORIES' (CATÉGORIES / MARQUES)
    // ============================================================================
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================================================================
    // RÈGLES POUR LA COLLECTION 'ORDERS' (COMMANDES)
    // ============================================================================
    match /orders/{orderId} {
      allow get: if true;
      allow list: if isAdmin() || 
                    (request.auth != null && resource.data.userId == request.auth.uid) ||
                    (request.query.limit == 1);
      allow create: if true;
      allow update: if isAdmin() || (
        request.auth != null && 
        resource.data.userId == request.auth.uid && 
        resource.data.status == 'pending' &&
        request.resource.data.status == 'pending' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'paymentOption', 'discountAmount', 'total', 'amountToPayNow', 'fullPaymentDiscount', 'updatedAt'
        ])
      );
      allow delete: if isAdmin();
    }

    // ============================================================================
    // RÈGLES POUR LA COLLECTION 'CLIENTS' (CLIENTS)
    // ============================================================================
    match /clients/{clientId} {
      allow read, write: if isAdmin() || (request.auth != null && request.auth.uid == clientId);
    }

    // ============================================================================
    // RÈGLES POUR LA COLLECTION 'PROMOTIONS'
    // ============================================================================
    match /promotions/{promoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================================================================
    // RÈGLES POUR LA COLLECTION 'BANNERS' (BANNIÈRES)
    // ============================================================================
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================================================================
    // RÈGLES POUR LA COLLECTION 'SETTINGS' (PARAMÈTRES GLOBAUX)
    // ============================================================================
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================================================================
    // NOUVELLES RÈGLES AUTORISANT L'ACCÈS AU BACK-OFFICE POUR LES MAILS & SUPPRESSION CLIENTS
    // ============================================================================
    match /email_templates/{templateId} {
      allow read, write: if isAdmin();
    }

    match /email_history/{historyId} {
      allow read, write: if isAdmin();
    }

    match /deleted_clients/{clientId} {
      allow read, write: if isAdmin();
    }

    match /smtp_settings/{settingId} {
      allow read, write: if isAdmin();
    }
    
    // Par défaut, refuser tout accès aux autres collections non définies
    match /{document=**} {
      allow read, write: if false;
    }
  }
}